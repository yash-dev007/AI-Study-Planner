# LecturePlan AI — environment template (SQLite only)
#
# Copy this file to backend/.env — the backend loads it from that directory:
#   cp .env.example backend/.env
#
# Generate a JWT secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Every value below is optional except JWT_SECRET for anything beyond local use.
# The application runs fully offline with AI and email disabled.

# --- application -----------------------------------------------------------
APP_ENV=development
DEBUG=false
API_PORT=8000

# --- security --------------------------------------------------------------
# Replace with a long random value. Never commit the real value.
JWT_SECRET="change-me-to-a-long-random-value"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- database --------------------------------------------------------------
# Default (used when this line is absent): sqlite:///backend/data/app.db
# Relative paths resolve from the process working directory, so prefer absolute
# paths locally. WAL mode and foreign keys are enabled by the application.
# DATABASE_URL=sqlite:///./data/app.db

# --- files -----------------------------------------------------------------
# Default: backend/storage
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
OCR_ENABLED=false

# --- scheduling defaults ---------------------------------------------------
DEFAULT_TOPIC_MINUTES=60
MIN_TOPIC_MINUTES=15
MAX_TOPIC_MINUTES=480

# --- demo data -------------------------------------------------------------
# Seeds a demo teacher and subject on first startup. Never enable in production.
SEED_DEMO_DATA=true

# --- AI provider (optional) ------------------------------------------------
# "none" keeps the deterministic rule-based workflow and requires no network.
# Provider choice and model can also be set per teacher in Settings; API keys
# stay server-side and are never returned by the API.
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=60
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- email (optional; weekly summaries) ------------------------------------
# Leave unset to keep email disabled. Empty SMTP_HOST means "not configured".
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# --- CORS ------------------------------------------------------------------
# Development Vite origins are allowed by default. Add more comma-separated.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- sessions --------------------------------------------------------------
# Login sets an HttpOnly, SameSite=Lax cookie. Bearer tokens are still accepted
# for tests and API clients, and take precedence over a stale cookie. A password
# change revokes every previously issued token.
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# ACCESS_TOKEN_COOKIE=access_token
